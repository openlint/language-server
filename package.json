{
  "name": "openlint-language-server",
  "version": "0.0.1",
  "description": "A language server for OpenLint: the same engine and results as the CLI, in any editor.",
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "https://github.com/openlint/language-server.git" },
  "bin": { "openlint-language-server": "bin/openlint-language-server.js" },
  "main": "dist/server.js",
  "files": ["bin", "dist"],
  "engines": { "node": "^22.0 || >= 24.0" },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@openlint/openlint-core": "0.0.1",
    "@openlint/openlint-parsers": "0.0.1",
    "@openlint/openlint-rulesets": "0.0.1",
    "openlint": "1.0.0",
    "vscode-languageserver": "9.0.1",
    "vscode-languageserver-textdocument": "1.0.12"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "typescript": "5.7.2"
  }
}
